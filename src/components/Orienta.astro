---
import { SITE, INSTAGRAM_WEB } from '../config.js';
const passos = [
  'à quinta abrem as encomendas da fornada, nos stories do instagram',
  'encomendas até sexta, por DM no instagram',
  'passas o guito (mb way ou revolut) e recebes a confirmação',
  'levantas sábado ou domingo, das 12:00 às 13:00, perto do liceu, em faro',
];
---
<section class="ori" id="orienta" aria-labelledby="ori-titulo">
  <p class="etiqueta">02 · ORIENTA-TE</p>
  <h2 id="ori-titulo" class="ori-titulo">não temos loja.<br /><span>temos código.</span></h2>
  <ol class="ori-passos">
    {passos.map((p, i) => (<li><span class="ori-num">{String(i + 1).padStart(2, '0')}</span><span>{p}</span></li>))}
  </ol>
  <p class="ori-extra">quantidades grandes, fora de horas? <span>também se arranja. é uma questão de falarmos.</span></p>
  <a class="ori-ig" href={INSTAGRAM_WEB} data-ig rel="noopener">
    <span><span class="ori-ig-1">INSTAGRAM · DM</span><span class="ori-ig-2">@{SITE.instagram}</span></span>
    <span aria-hidden="true">→</span>
  </a>
  <a class="ori-lista" href="#lista-titulo">ou entra na lista e és avisado por email ↑</a>
</section>

<style>
  .ori { padding: 64px var(--margem) 72px; max-width: 1180px; margin: 0 auto; border-top: 1px solid var(--linha); }
  .ori .etiqueta { margin: 0 0 16px; font-size: 11px; letter-spacing: 3px; }
  .ori-titulo { margin: 0 0 30px; font-family: var(--font-display); font-weight: 400; font-size: clamp(44px, 12vw, 64px); line-height: 0.92; color: var(--osso); filter: url(#rough); }
  .ori-titulo span { color: var(--betao); }
  .ori-passos { list-style: none; margin: 0; padding: 0; max-width: 560px; }
  .ori-passos li { display: grid; grid-template-columns: 38px 1fr; gap: 10px; padding: 14px 0; border-bottom: 1px dashed var(--fechado); font-size: 14px; line-height: 1.7; color: var(--osso); }
  .ori-num { font-weight: 700; color: var(--betao); }
  .ori-extra { margin: 24px 0 28px; max-width: 560px; font-size: 13px; line-height: 1.8; color: var(--osso); }
  .ori-extra span { color: var(--betao); }
  .ori-ig { display: flex; justify-content: space-between; align-items: center; gap: 16px; max-width: 560px; border: 1px solid var(--osso); color: var(--osso); padding: 16px 20px; }
  .ori-ig:hover { background: var(--osso); color: var(--preto); }
  .ori-ig > span:first-child { display: flex; flex-direction: column; gap: 4px; }
  .ori-ig-1 { font-family: var(--font-display); font-size: clamp(22px, 6vw, 28px); line-height: 1; }
  .ori-ig-2 { font-size: 12px; letter-spacing: 1px; opacity: 0.8; }
  .ori-ig > span:last-child { font-size: 26px; }
  .ori-lista { display: inline-block; margin-top: 16px; font-size: 12px; color: var(--betao); text-decoration: underline; text-underline-offset: 3px; }
</style>
